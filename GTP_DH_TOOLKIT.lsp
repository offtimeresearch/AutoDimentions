  (setq x (gtp:vunit (gtp:cross ref z)) y (gtp:cross z x))
  (list (list (car x) (car y) (car z) (car p1)) (list (cadr x) (cadr y) (cadr z) (cadr p1)) (list (caddr x) (caddr y) (caddr z) (caddr p1)) (list 0.0 0.0 0.0 1.0))
)
