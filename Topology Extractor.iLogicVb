AddReference "System.Windows.Forms"
Imports System
Imports System.Text
Imports System.Text.RegularExpressions
Imports System.Collections.Generic
Imports System.Globalization
Imports System.Windows.Forms



Sub Main()

    ' ============================================================
    ' AUTO SPOOL TOPOLOGY STUDY V0.2
    '
    ' SELECT MULTIPLE IAM FILES
    '        ↓
    ' SCAN COMPONENTS + PORTS
    '        ↓
    ' DETECT CONNECTIONS
    '        ↓
    ' BUILD GRAPH
    '        ↓
    ' GENERATE SVG SCHEMATIC
    '        ↓
    ' CREATE MASTER CSV + CONNECTION CSV
    ' ============================================================


    Dim dlg As New OpenFileDialog()

    dlg.Title = "Select Spool Assemblies"
    dlg.Filter = "Inventor Assembly (*.iam)|*.iam"
    dlg.Multiselect = True

    Try
        dlg.InitialDirectory = _
            ThisApplication.DesignProjectManager.ActiveDesignProject.WorkspacePath
    Catch
    End Try


    If dlg.ShowDialog() <> DialogResult.OK Then
        Exit Sub
    End If


    Dim selectedFiles() As String = dlg.FileNames

    If selectedFiles Is Nothing OrElse selectedFiles.Length = 0 Then
        Exit Sub
    End If


    ' ============================================================
    ' OUTPUT FOLDERS
    ' ============================================================

    Dim rootFolder As String = _
        System.IO.Path.Combine( _
            System.IO.Path.GetDirectoryName(selectedFiles(0)), _
            "_AutoSpoolStudy")

    Dim schematicFolder As String = _
        System.IO.Path.Combine(rootFolder, "Schematics")


    System.IO.Directory.CreateDirectory(rootFolder)
    System.IO.Directory.CreateDirectory(schematicFolder)


    Dim masterCsv As String = _
        System.IO.Path.Combine( _
            rootFolder, _
            "AutoSpool_Master_" & _
            DateTime.Now.ToString("yyyyMMdd_HHmmss") & _
            ".csv")

    Dim connectionCsv As String = _
        System.IO.Path.Combine( _
            rootFolder, _
            "AutoSpool_Connections_" & _
            DateTime.Now.ToString("yyyyMMdd_HHmmss") & _
            ".csv")


    Dim masterWriter As New System.IO.StreamWriter( _
        masterCsv, False, Encoding.UTF8)

    Dim connectionWriter As New System.IO.StreamWriter( _
        connectionCsv, False, Encoding.UTF8)


    masterWriter.WriteLine( _
        "Assembly," & _
        "Components," & _
        "Connections," & _
        "Endpoints," & _
        "BranchNodes," & _
        "Flanges," & _
        "Elbows," & _
        "Tees," & _
        "Reducers," & _
        "Pipes," & _
        "Valves," & _
        "Other," & _
        "UnconnectedComponents," & _
        "Topology," & _
        "Verified," & _
        "CorrectedTopology," & _
        "DimensionPattern," & _
        "Notes")


    connectionWriter.WriteLine( _
        "Assembly," & _
        "NodeA," & _
        "TypeA," & _
        "NodeB," & _
        "TypeB," & _
        "ConnectionType," & _
        "Distance_mm")


    Dim completed As Integer = 0
    Dim failed As Integer = 0


    ' ============================================================
    ' PROCESS ASSEMBLIES
    ' ============================================================

    For Each iamFile As String In selectedFiles

        Dim asmDoc As AssemblyDocument = Nothing
        Dim alreadyOpen As Boolean = False

        Try

            asmDoc = GetAssemblyDocument(iamFile, alreadyOpen)

            If asmDoc Is Nothing Then
                Throw New Exception("Assembly could not be opened.")
            End If


            ' ----------------------------------------------------
            ' SCAN
            ' ----------------------------------------------------

            Dim nodes As List(Of NodeRecord) = _
                ScanAssembly(asmDoc)


            ' ----------------------------------------------------
            ' CONNECTIONS
            ' ----------------------------------------------------

            Dim connections As List(Of EdgeRecord) = _
                DetectConnections(nodes)


            ' ----------------------------------------------------
            ' SYMBOLIC NAMES
            '
            ' F1 = Flange
            ' E1 = Elbow
            ' T1 = Tee
            ' P1 = Pipe
            ' R1 = Reducer
            ' ----------------------------------------------------

            AssignDisplayCodes(nodes)


            ' ----------------------------------------------------
            ' MAIN PATH
            ' ----------------------------------------------------

            Dim mainPath As List(Of NodeRecord) = _
                FindMainPath(nodes)


            Dim topology As String = _
                BuildTopologySignature(nodes, mainPath)


            Dim asmName As String = _
                System.IO.Path.GetFileNameWithoutExtension(iamFile)


            ' ----------------------------------------------------
            ' SVG
            ' ----------------------------------------------------

            Dim svgFile As String = _
                System.IO.Path.Combine( _
                    schematicFolder, _
                    SafeFileName(asmName) & ".svg")


            GenerateSchematic( _
                asmName, _
                nodes, _
                connections, _
                mainPath, _
                topology, _
                svgFile)


            ' ----------------------------------------------------
            ' COUNTS
            ' ----------------------------------------------------

            Dim endpointCount As Integer = 0
            Dim branchCount As Integer = 0

            Dim looseNodes As New List(Of String)


            For Each n As NodeRecord In nodes

                If n.Neighbours.Count = 1 Then
                    endpointCount += 1
                End If

                If n.Neighbours.Count >= 3 Then
                    branchCount += 1
                End If

                If n.Neighbours.Count = 0 Then
                    looseNodes.Add(n.Code)
                End If

            Next


            ' ----------------------------------------------------
            ' MASTER CSV ROW
            ' ----------------------------------------------------

            masterWriter.WriteLine( _
                Csv(asmName) & "," & _
                nodes.Count.ToString() & "," & _
                connections.Count.ToString() & "," & _
                endpointCount.ToString() & "," & _
                branchCount.ToString() & "," & _
                CountType(nodes, "FLANGE").ToString() & "," & _
                CountType(nodes, "ELBOW").ToString() & "," & _
                CountType(nodes, "TEE").ToString() & "," & _
                CountType(nodes, "REDUCER").ToString() & "," & _
                CountType(nodes, "PIPE").ToString() & "," & _
                CountType(nodes, "VALVE").ToString() & "," & _
                CountType(nodes, "OTHER").ToString() & "," & _
                Csv(String.Join(";", looseNodes.ToArray())) & "," & _
                Csv(topology) & "," & _
                Csv("") & "," & _
                Csv("") & "," & _
                Csv("") & "," & _
                Csv(""))


            ' ----------------------------------------------------
            ' CONNECTION CSV
            ' ----------------------------------------------------

            For Each c As EdgeRecord In connections

                connectionWriter.WriteLine( _
                    Csv(asmName) & "," & _
                    Csv(c.A.Code) & "," & _
                    Csv(c.A.ComponentType) & "," & _
                    Csv(c.B.Code) & "," & _
                    Csv(c.B.ComponentType) & "," & _
                    Csv(c.ConnectionType) & "," & _
                    Num(c.ConnectionDistance))

            Next


            masterWriter.Flush()
            connectionWriter.Flush()

            completed += 1


        Catch ex As Exception

            failed += 1

            Logger.Error( _
                System.IO.Path.GetFileName(iamFile) & _
                " : " & _
                ex.Message)

        Finally

            If asmDoc IsNot Nothing AndAlso Not alreadyOpen Then

                Try
                    asmDoc.Close(True)
                Catch
                End Try

            End If

        End Try

    Next


    masterWriter.Close()
    connectionWriter.Close()


    MessageBox.Show( _
        "Topology study complete." & vbCrLf & vbCrLf & _
        "Completed: " & completed.ToString() & vbCrLf & _
        "Failed: " & failed.ToString() & vbCrLf & vbCrLf & _
        "Output:" & vbCrLf & _
        rootFolder, _
        "AutoSpool")


    System.Diagnostics.Process.Start( _
        "explorer.exe", _
        rootFolder)

End Sub



' ================================================================
' SCAN ASSEMBLY
' ================================================================

Function ScanAssembly( _
    asmDoc As AssemblyDocument) As List(Of NodeRecord)


    Dim result As New List(Of NodeRecord)

    Dim allOccurrences As ComponentOccurrencesEnumerator = _
        asmDoc.ComponentDefinition.Occurrences.AllLeafOccurrences


    For Each occ As ComponentOccurrence In allOccurrences

        Try

            If occ.Suppressed Then
                Continue For
            End If


            Dim node As New NodeRecord

            node.OccurrenceName = occ.Name


            ' ----------------------------------------------------
            ' IPROPERTIES
            ' ----------------------------------------------------

            Dim refDoc As Document = Nothing

            Try
                refDoc = occ.Definition.Document
            Catch
            End Try


            If refDoc IsNot Nothing Then

                node.PartNumber = _
                    GetIProperty( _
                        refDoc, _
                        "Design Tracking Properties", _
                        "Part Number")

                node.Description = _
                    GetIProperty( _
                        refDoc, _
                        "Design Tracking Properties", _
                        "Description")

            End If


            node.ComponentType = _
                GuessComponentType( _
                    node.PartNumber, _
                    node.Description, _
                    node.OccurrenceName)


            ' ----------------------------------------------------
            ' OCCURRENCE CENTER
            ' Inventor geometry units = cm
            ' Convert to mm.
            ' ----------------------------------------------------

            Dim rb As Box = occ.RangeBox


            node.X = _
                ((rb.MinPoint.X + rb.MaxPoint.X) / 2.0) * 10.0

            node.Y = _
                ((rb.MinPoint.Y + rb.MaxPoint.Y) / 2.0) * 10.0

            node.Z = _
                ((rb.MinPoint.Z + rb.MaxPoint.Z) / 2.0) * 10.0


            ' ----------------------------------------------------
            ' FIND PORT CANDIDATES
            '
            ' PLANAR FACE + CIRCULAR EDGE
            ' ----------------------------------------------------

            Dim faceCounter As Integer = 0


            For Each body As SurfaceBody In occ.SurfaceBodies

                For Each face As Face In body.Faces

                    faceCounter += 1


                    If Face.SurfaceType <> _
                       SurfaceTypeEnum.kPlaneSurface Then

                        Continue For
                    End If


                    Dim biggestCircle As Inventor.Circle = Nothing


                    For Each edge As Edge In Face.Edges

                        Try

                            If Edge.GeometryType = _
                               CurveTypeEnum.kCircleCurve Then


                                Dim circle As Inventor.Circle = _
                                    CType(Edge.Geometry, Inventor.Circle)


                                If biggestCircle Is Nothing Then

                                    biggestCircle = circle

                                ElseIf circle.Radius > _
                                       biggestCircle.Radius Then

                                    biggestCircle = circle

                                End If

                            End If

                        Catch
                        End Try

                    Next


                    If biggestCircle Is Nothing Then
                        Continue For
                    End If


                    Dim plane As Inventor.Plane = Nothing

                    Try
                        plane = CType(Face.Geometry, Inventor.Plane)
                    Catch
                        Continue For
                    End Try


                    Dim port As New PortRecord

                    port.Owner = node
                    port.FaceIndex = faceCounter


                    port.X = biggestCircle.Center.X * 10.0
                    port.Y = biggestCircle.Center.Y * 10.0
                    port.Z = biggestCircle.Center.Z * 10.0


                    port.NX = plane.Normal.X
                    port.NY = plane.Normal.Y
                    port.NZ = plane.Normal.Z


                    Try

                        If Face.IsParamReversed Then

                            port.NX *= -1.0
                            port.NY *= -1.0
                            port.NZ *= -1.0

                        End If

                    Catch
                    End Try


                    port.Radius = _
                        biggestCircle.Radius * 10.0


                    AddPortIfUnique(node.Ports, port)

                Next

            Next


            result.Add(node)


        Catch ex As Exception

            Logger.Error( _
                "Scan error: " & _
                occ.Name & _
                " : " & _
                ex.Message)

        End Try

    Next


    Return result

End Function



' ================================================================
' CONNECTION DETECTION
' ================================================================

Function DetectConnections( _
    nodes As List(Of NodeRecord)) As List(Of EdgeRecord)


    ' IMPORTANT:
    ' Keep settings INSIDE the function.
    ' iLogic complained about namespace-level constants previously.

    Dim directTolerance As Double = 1.0

    Dim flangeSearchDistance As Double = 50.0

    Dim lateralTolerance As Double = 2.0

    Dim minimumNormalAlignment As Double = 0.90


    Dim result As New List(Of EdgeRecord)

    Dim nonFlangePorts As New List(Of PortRecord)


    For Each node As NodeRecord In nodes

        If node.ComponentType <> "FLANGE" Then

            For Each port As PortRecord In node.Ports
                nonFlangePorts.Add(port)
            Next

        End If

    Next


    ' ============================================================
    ' PASS 1
    '
    ' DIRECT FITTING CONNECTIONS
    '
    ' Tee ↔ Pipe
    ' Tee ↔ Elbow
    ' Pipe ↔ Reducer
    ' etc.
    ' ============================================================

    For i As Integer = 0 To nonFlangePorts.Count - 1

        For j As Integer = i + 1 To nonFlangePorts.Count - 1


            Dim portA As PortRecord = _
                nonFlangePorts.Item(i)

            Dim portB As PortRecord = _
                nonFlangePorts.Item(j)


            If portA.Owner Is portB.Owner Then
                Continue For
            End If


            If HasConnection( _
                result, _
                portA.Owner, _
                portB.Owner) Then

                Continue For
            End If


            Dim portDistance As Double = _
                Dist3D( _
                    portA.X, _
                    portA.Y, _
                    portA.Z, _
                    portB.X, _
                    portB.Y, _
                    portB.Z)


            If portDistance > directTolerance Then
                Continue For
            End If


            Dim dotValue As Double = _
                NormalDot(portA, portB)


            If dotValue > -minimumNormalAlignment Then
                Continue For
            End If


            AddConnection( _
                result, _
                portA, _
                portB, _
                "DIRECT", _
                portDistance)

        Next

    Next


    ' ============================================================
    ' PASS 2
    '
    ' FLANGE SEARCH
    '
    ' Only search for flange when that particular component port
    ' did not receive a direct fitting connection.
    ' ============================================================

    For Each componentNode As NodeRecord In nodes


        If componentNode.ComponentType = "FLANGE" Then
            Continue For
        End If


        For Each componentPort As PortRecord In componentNode.Ports


            If componentPort.Used Then
                Continue For
            End If


            Dim bestFlange As NodeRecord = Nothing

            Dim bestFlangePort As PortRecord = Nothing

            Dim bestScore As Double = Double.MaxValue


            For Each flangeNode As NodeRecord In nodes


                If flangeNode.ComponentType <> "FLANGE" Then
                    Continue For
                End If


                If flangeNode.Neighbours.Count > 0 Then
                    Continue For
                End If


                For Each flangePort As PortRecord In flangeNode.Ports


                    Dim dx As Double = _
                        flangePort.X - componentPort.X

                    Dim dy As Double = _
                        flangePort.Y - componentPort.Y

                    Dim dz As Double = _
                        flangePort.Z - componentPort.Z


                    Dim totalDistance As Double = _
                        Math.Sqrt( _
                            dx * dx + _
                            dy * dy + _
                            dz * dz)


                    If totalDistance > flangeSearchDistance Then
                        Continue For
                    End If


                    ' ------------------------------------------------
                    ' AXIAL DISTANCE ALONG PORT NORMAL
                    ' ------------------------------------------------

                    Dim axialDistance As Double = _
                        Math.Abs( _
                            dx * componentPort.NX + _
                            dy * componentPort.NY + _
                            dz * componentPort.NZ)


                    ' ------------------------------------------------
                    ' LATERAL OFFSET FROM PORT AXIS
                    ' ------------------------------------------------

                    Dim lateralSquared As Double = _
                        totalDistance * totalDistance - _
                        axialDistance * axialDistance


                    If lateralSquared < 0 Then
                        lateralSquared = 0
                    End If


                    Dim lateralDistance As Double = _
                        Math.Sqrt(lateralSquared)


                    If lateralDistance > lateralTolerance Then
                        Continue For
                    End If


                    ' ------------------------------------------------
                    ' NORMAL ALIGNMENT
                    '
                    ' Absolute here because flange candidate faces
                    ' may point either way.
                    ' ------------------------------------------------

                    Dim alignment As Double = _
                        Math.Abs( _
                            NormalDot( _
                                componentPort, _
                                flangePort))


                    If alignment < minimumNormalAlignment Then
                        Continue For
                    End If


                    Dim score As Double = _
                        totalDistance + _
                        lateralDistance * 10.0 + _
                        (1.0 - alignment) * 100.0


                    If score < bestScore Then

                        bestScore = score
                        bestFlange = flangeNode
                        bestFlangePort = flangePort

                    End If

                Next

            Next


            If bestFlange IsNot Nothing AndAlso _
               bestFlangePort IsNot Nothing Then


                Dim flangeDistance As Double = _
                    Dist3D( _
                        componentPort.X, _
                        componentPort.Y, _
                        componentPort.Z, _
                        bestFlangePort.X, _
                        bestFlangePort.Y, _
                        bestFlangePort.Z)


                AddConnection( _
                    result, _
                    componentPort, _
                    bestFlangePort, _
                    "FLANGED_END", _
                    flangeDistance)

            End If

        Next

    Next


    Return result

End Function



' ================================================================
' ADD CONNECTION
' ================================================================

Sub AddConnection( _
    edges As List(Of EdgeRecord), _
    portA As PortRecord, _
    portB As PortRecord, _
    connectionType As String, _
    connectionDistance As Double)


    If HasConnection( _
        edges, _
        portA.Owner, _
        portB.Owner) Then

        Exit Sub
    End If


    Dim e As New EdgeRecord

    e.A = portA.Owner
    e.B = portB.Owner

    e.ConnectionType = connectionType

    e.ConnectionDistance = connectionDistance


    edges.Add(e)


    portA.Owner.Neighbours.Add(portB.Owner)

    portB.Owner.Neighbours.Add(portA.Owner)


    portA.Used = True

    portB.Used = True

End Sub



' ================================================================
' ASSIGN SYMBOL NAMES
' ================================================================

Sub AssignDisplayCodes( _
    nodes As List(Of NodeRecord))


    Dim counters As New Dictionary(Of String, Integer)


    For Each node As NodeRecord In nodes


        Dim prefix As String = "X"


        Select Case node.ComponentType

            Case "FLANGE"
                prefix = "F"

            Case "ELBOW"
                prefix = "E"

            Case "TEE"
                prefix = "T"

            Case "PIPE"
                prefix = "P"

            Case "REDUCER"
                prefix = "R"

            Case "VALVE"
                prefix = "V"

            Case "COUPLING_SOCKET"
                prefix = "C"

        End Select


        If Not counters.ContainsKey(prefix) Then
            counters.Add(prefix, 0)
        End If


        counters(prefix) = counters(prefix) + 1


        node.Code = _
            prefix & _
            counters(prefix).ToString()

    Next

End Sub



' ================================================================
' FIND MAIN PATH
'
' Longest endpoint-to-endpoint graph path.
' ================================================================

Function FindMainPath( _
    nodes As List(Of NodeRecord)) As List(Of NodeRecord)


    Dim endpoints As New List(Of NodeRecord)


    For Each node As NodeRecord In nodes

        If node.Neighbours.Count = 1 Then
            endpoints.Add(node)
        End If

    Next


    Dim emptyResult As New List(Of NodeRecord)


    If endpoints.Count = 0 Then

        If nodes.Count > 0 Then
            emptyResult.Add(nodes.Item(0))
        End If

        Return emptyResult
    End If


    If endpoints.Count = 1 Then

        emptyResult.Add(endpoints.Item(0))

        Return emptyResult
    End If


    Dim bestPath As New List(Of NodeRecord)

    Dim bestLength As Double = -1.0


    For i As Integer = 0 To endpoints.Count - 2

        For j As Integer = i + 1 To endpoints.Count - 1


            Dim candidate As New List(Of NodeRecord)

            Dim visited As New HashSet(Of NodeRecord)


            If FindPathRecursive( _
                endpoints.Item(i), _
                endpoints.Item(j), _
                visited, _
                candidate) Then


                Dim pathLength As Double = 0.0


                For k As Integer = 0 To candidate.Count - 2

                    Dim a As NodeRecord = _
                        candidate.Item(k)

                    Dim b As NodeRecord = _
                        candidate.Item(k + 1)


                    pathLength += _
                        Dist3D( _
                            a.X, a.Y, a.Z, _
                            b.X, b.Y, b.Z)

                Next


                If pathLength > bestLength Then

                    bestLength = pathLength

                    bestPath = _
                        New List(Of NodeRecord)(candidate)

                End If

            End If

        Next

    Next


    Return bestPath

End Function



Function FindPathRecursive( _
    currentNode As NodeRecord, _
    targetNode As NodeRecord, _
    visited As HashSet(Of NodeRecord), _
    currentPath As List(Of NodeRecord)) As Boolean


    visited.Add(currentNode)

    currentPath.Add(currentNode)


    If currentNode Is targetNode Then
        Return True
    End If


    For Each nextNode As NodeRecord In currentNode.Neighbours


        If visited.Contains(nextNode) Then
            Continue For
        End If


        If FindPathRecursive( _
            nextNode, _
            targetNode, _
            visited, _
            currentPath) Then

            Return True
        End If

    Next


    currentPath.RemoveAt(currentPath.Count - 1)


    Return False

End Function



' ================================================================
' TOPOLOGY SIGNATURE
' ================================================================

Function BuildTopologySignature( _
    nodes As List(Of NodeRecord), _
    mainPath As List(Of NodeRecord)) As String


    If mainPath Is Nothing OrElse mainPath.Count = 0 Then
        Return "NO_PATH"
    End If


    Dim mainSet As New HashSet(Of NodeRecord)

    Dim mainParts As New List(Of String)


    For Each node As NodeRecord In mainPath

        mainSet.Add(node)

        mainParts.Add(node.Code)

    Next


    Dim topology As String = _
        String.Join("-", mainParts.ToArray())


    Dim branches As New List(Of String)


    For Each mainNode As NodeRecord In mainPath

        For Each neighbour As NodeRecord In mainNode.Neighbours


            If mainSet.Contains(neighbour) Then
                Continue For
            End If


            Dim branchText As String = _
                mainNode.Code & _
                ":" & _
                BuildBranchSignature( _
                    neighbour, _
                    mainNode, _
                    mainSet)


            branches.Add(branchText)

        Next

    Next


    If branches.Count > 0 Then

        topology &= _
            " | " & _
            String.Join(" | ", branches.ToArray())

    End If


    Return topology

End Function



Function BuildBranchSignature( _
    node As NodeRecord, _
    parentNode As NodeRecord, _
    mainSet As HashSet(Of NodeRecord)) As String


    Dim children As New List(Of NodeRecord)


    For Each child As NodeRecord In node.Neighbours

        If child Is parentNode Then
            Continue For
        End If

        If mainSet.Contains(child) Then
            Continue For
        End If

        children.Add(child)

    Next


    If children.Count = 0 Then
        Return node.Code
    End If


    If children.Count = 1 Then

        Return _
            node.Code & _
            "-" & _
            BuildBranchSignature( _
                children.Item(0), _
                node, _
                mainSet)

    End If


    Dim childStrings As New List(Of String)


    For Each child As NodeRecord In children

        childStrings.Add( _
            BuildBranchSignature( _
                child, _
                node, _
                mainSet))

    Next


    Return _
        node.Code & _
        "(" & _
        String.Join("|", childStrings.ToArray()) & _
        ")"

End Function



' ================================================================
' GENERATE SVG SCHEMATIC
' ================================================================

Sub GenerateSchematic( _
    assemblyName As String, _
    nodes As List(Of NodeRecord), _
    edges As List(Of EdgeRecord), _
    mainPath As List(Of NodeRecord), _
    topology As String, _
    outputFile As String)


    Dim positions As _
        New Dictionary(Of NodeRecord, SvgPoint)


    Dim mainSet As New HashSet(Of NodeRecord)


    For Each node As NodeRecord In mainPath
        mainSet.Add(node)
    Next


    Dim baseY As Double = 330.0


    ' ------------------------------------------------------------
    ' MAIN PATH
    ' ------------------------------------------------------------

    If mainPath.Count = 1 Then

        positions.Add( _
            mainPath.Item(0), _
            New SvgPoint(500, baseY))


    ElseIf mainPath.Count > 1 Then


        Dim spacing As Double = _
            750.0 / _
            (mainPath.Count - 1)


        For i As Integer = 0 To mainPath.Count - 1

            positions.Add( _
                mainPath.Item(i), _
                New SvgPoint( _
                    100.0 + spacing * i, _
                    baseY))

        Next

    End If


    ' ------------------------------------------------------------
    ' BRANCHES
    ' ------------------------------------------------------------

    Dim branchNumber As Integer = 0


    For Each mainNode As NodeRecord In mainPath

        For Each neighbour As NodeRecord In mainNode.Neighbours


            If mainSet.Contains(neighbour) Then
                Continue For
            End If


            branchNumber += 1


            Dim branchDirection As Integer = -1


            If branchNumber Mod 2 = 0 Then
                branchDirection = 1
            End If


            PlaceBranch( _
                neighbour, _
                mainNode, _
                positions(mainNode).X, _
                baseY, _
                branchDirection, _
                1, _
                positions, _
                mainSet)

        Next

    Next


    ' ------------------------------------------------------------
    ' ANY COMPONENT NOT PART OF DETECTED GRAPH
    ' ------------------------------------------------------------

    Dim looseX As Double = 100.0


    For Each node As NodeRecord In nodes

        If Not positions.ContainsKey(node) Then

            positions.Add( _
                node, _
                New SvgPoint(looseX, 600))

            looseX += 100

        End If

    Next


    ' ------------------------------------------------------------
    ' SVG
    ' ------------------------------------------------------------

    Dim svg As New StringBuilder


    svg.AppendLine( _
        "<svg xmlns=""http://www.w3.org/2000/svg"" " & _
        "width=""1200"" height=""700"" " & _
        "viewBox=""0 0 1200 700"">")


    svg.AppendLine( _
        "<rect x=""1"" y=""1"" width=""1198"" height=""698"" " & _
        "fill=""white"" stroke=""black""/>")


    svg.AppendLine( _
        "<text x=""30"" y=""40"" " & _
        "font-family=""Arial"" font-size=""22"" font-weight=""bold"">" & _
        XmlText(assemblyName) & _
        "</text>")


    svg.AppendLine( _
        "<text x=""30"" y=""70"" " & _
        "font-family=""Arial"" font-size=""15"">Topology: " & _
        XmlText(topology) & _
        "</text>")


    ' ------------------------------------------------------------
    ' CONNECTION LINES
    ' ------------------------------------------------------------

    For Each edge As EdgeRecord In edges


        If Not positions.ContainsKey(Edge.A) OrElse _
           Not positions.ContainsKey(Edge.B) Then

            Continue For
        End If


        Dim a As SvgPoint = positions(Edge.A)

        Dim b As SvgPoint = positions(Edge.B)


        svg.AppendLine( _
            "<line x1=""" & Num(a.X) & _
            """ y1=""" & Num(a.Y) & _
            """ x2=""" & Num(b.X) & _
            """ y2=""" & Num(b.Y) & _
            """ stroke=""black"" stroke-width=""4""/>")

    Next


    ' ------------------------------------------------------------
    ' SYMBOLS
    ' ------------------------------------------------------------

    For Each node As NodeRecord In nodes

        Dim p As SvgPoint = positions(node)

        DrawSymbol(svg, node, p.X, p.Y)

    Next


    ' ------------------------------------------------------------
    ' LEGEND
    ' ------------------------------------------------------------

    Dim legendY As Double = 110.0


    For Each node As NodeRecord In nodes

        svg.AppendLine( _
            "<text x=""880"" y=""" & _
            Num(legendY) & _
            """ font-family=""Arial"" font-size=""12"">" & _
            XmlText( _
                node.Code & _
                " = " & _
                node.ComponentType & _
                " | " & _
                node.PartNumber) & _
            "</text>")


        legendY += 18

    Next


    svg.AppendLine("</svg>")


    System.IO.File.WriteAllText( _
        outputFile, _
        svg.ToString(), _
        Encoding.UTF8)

End Sub



' ================================================================
' BRANCH LAYOUT
' ================================================================

Sub PlaceBranch( _
    node As NodeRecord, _
    parentNode As NodeRecord, _
    startX As Double, _
    baseY As Double, _
    direction As Integer, _
    depth As Integer, _
    positions As Dictionary(Of NodeRecord, SvgPoint), _
    mainSet As HashSet(Of NodeRecord))


    If positions.ContainsKey(node) Then
        Exit Sub
    End If


    positions.Add( _
        node, _
        New SvgPoint( _
            startX, _
            baseY + _
            direction * depth * 100.0))


    Dim children As New List(Of NodeRecord)


    For Each child As NodeRecord In node.Neighbours

        If child Is parentNode Then
            Continue For
        End If

        If mainSet.Contains(child) Then
            Continue For
        End If

        children.Add(child)

    Next


    For i As Integer = 0 To children.Count - 1


        Dim childX As Double = startX


        If children.Count > 1 Then

            childX += _
                (i - (children.Count - 1) / 2.0) * _
                80.0

        End If


        PlaceBranch( _
            children.Item(i), _
            node, _
            childX, _
            baseY, _
            direction, _
            depth + 1, _
            positions, _
            mainSet)

    Next

End Sub



' ================================================================
' SYMBOL DRAWING
' ================================================================

Sub DrawSymbol( _
    svg As StringBuilder, _
    node As NodeRecord, _
    x As Double, _
    y As Double)


    Select Case node.ComponentType


        Case "FLANGE"

            svg.AppendLine( _
                "<line x1=""" & Num(x - 6) & _
                """ y1=""" & Num(y - 24) & _
                """ x2=""" & Num(x - 6) & _
                """ y2=""" & Num(y + 24) & _
                """ stroke=""black"" stroke-width=""4""/>")

            svg.AppendLine( _
                "<line x1=""" & Num(x + 6) & _
                """ y1=""" & Num(y - 24) & _
                """ x2=""" & Num(x + 6) & _
                """ y2=""" & Num(y + 24) & _
                """ stroke=""black"" stroke-width=""4""/>")


        Case "TEE"

            svg.AppendLine( _
                "<line x1=""" & Num(x - 22) & _
                """ y1=""" & Num(y) & _
                """ x2=""" & Num(x + 22) & _
                """ y2=""" & Num(y) & _
                """ stroke=""black"" stroke-width=""5""/>")

            svg.AppendLine( _
                "<line x1=""" & Num(x) & _
                """ y1=""" & Num(y) & _
                """ x2=""" & Num(x) & _
                """ y2=""" & Num(y - 25) & _
                """ stroke=""black"" stroke-width=""5""/>")


        Case "ELBOW"

            svg.AppendLine( _
                "<path d=""M " & _
                Num(x - 25) & " " & Num(y + 12) & _
                " Q " & _
                Num(x - 25) & " " & Num(y - 15) & _
                " " & _
                Num(x + 5) & " " & Num(y - 15) & _
                """ fill=""none"" stroke=""black"" stroke-width=""5""/>")


        Case "REDUCER"

            svg.AppendLine( _
                "<polygon points=""" & _
                Num(x - 22) & "," & Num(y - 12) & " " & _
                Num(x + 22) & "," & Num(y - 6) & " " & _
                Num(x + 22) & "," & Num(y + 6) & " " & _
                Num(x - 22) & "," & Num(y + 12) & _
                """ fill=""white"" stroke=""black"" stroke-width=""3""/>")


        Case "PIPE"

            svg.AppendLine( _
                "<line x1=""" & Num(x - 28) & _
                """ y1=""" & Num(y) & _
                """ x2=""" & Num(x + 28) & _
                """ y2=""" & Num(y) & _
                """ stroke=""black"" stroke-width=""6""/>")


        Case "VALVE"

            svg.AppendLine( _
                "<circle cx=""" & Num(x) & _
                """ cy=""" & Num(y) & _
                """ r=""18"" fill=""white"" stroke=""black"" stroke-width=""3""/>")


        Case Else

            svg.AppendLine( _
                "<circle cx=""" & Num(x) & _
                """ cy=""" & Num(y) & _
                """ r=""15"" fill=""white"" stroke=""black"" stroke-width=""3""/>")

    End Select


    svg.AppendLine( _
        "<text x=""" & Num(x) & _
        """ y=""" & Num(y + 45) & _
        """ text-anchor=""middle"" " & _
        "font-family=""Arial"" font-size=""15"" font-weight=""bold"">" & _
        XmlText(node.Code) & _
        "</text>")

End Sub



' ================================================================
' ADD UNIQUE PORT
' ================================================================

Sub AddPortIfUnique( _
    ports As List(Of PortRecord), _
    newPort As PortRecord)


    For Each existing As PortRecord In ports


        Dim separation As Double = _
            Dist3D( _
                existing.X, _
                existing.Y, _
                existing.Z, _
                newPort.X, _
                newPort.Y, _
                newPort.Z)


        If separation < 0.1 Then


            Dim alignment As Double = _
                Math.Abs( _
                    NormalDot(existing, newPort))


            If alignment > 0.99 Then
                Exit Sub
            End If

        End If

    Next


    ports.Add(newPort)

End Sub



' ================================================================
' NORMAL DOT PRODUCT
' ================================================================

Function NormalDot( _
    a As PortRecord, _
    b As PortRecord) As Double


    Return _
        a.NX * b.NX + _
        a.NY * b.NY + _
        a.NZ * b.NZ

End Function



' ================================================================
' 3D DISTANCE
'
' Named Dist3D instead of Distance to avoid collision with
' Double variables / class properties.
' ================================================================

Function Dist3D( _
    x1 As Double, _
    y1 As Double, _
    z1 As Double, _
    x2 As Double, _
    y2 As Double, _
    z2 As Double) As Double


    Dim dx As Double = x2 - x1
    Dim dy As Double = y2 - y1
    Dim dz As Double = z2 - z1


    Return Math.Sqrt( _
        dx * dx + _
        dy * dy + _
        dz * dz)

End Function



' ================================================================
' CHECK EXISTING CONNECTION
' ================================================================

Function HasConnection( _
    edges As List(Of EdgeRecord), _
    nodeA As NodeRecord, _
    nodeB As NodeRecord) As Boolean


    For Each edge As EdgeRecord In edges


        If Edge.A Is nodeA AndAlso Edge.B Is nodeB Then
            Return True
        End If


        If Edge.A Is nodeB AndAlso Edge.B Is nodeA Then
            Return True
        End If

    Next


    Return False

End Function



' ================================================================
' COUNT COMPONENT TYPE
' ================================================================

Function CountType( _
    nodes As List(Of NodeRecord), _
    componentType As String) As Integer


    Dim result As Integer = 0


    For Each node As NodeRecord In nodes

        If node.ComponentType = componentType Then
            result += 1
        End If

    Next


    Return result

End Function



' ================================================================
' OPEN / GET ASSEMBLY
' ================================================================

Function GetAssemblyDocument( _
    fileName As String, _
    ByRef alreadyOpen As Boolean) As AssemblyDocument


    alreadyOpen = False


    For Each doc As Document In ThisApplication.Documents

        Try

            If String.Equals( _
                doc.FullFileName, _
                fileName, _
                StringComparison.OrdinalIgnoreCase) Then


                alreadyOpen = True

                Return CType(doc, AssemblyDocument)

            End If

        Catch
        End Try

    Next


    Dim openedDoc As Document = _
        ThisApplication.Documents.Open(fileName, False)


    Return CType(openedDoc, AssemblyDocument)

End Function



' ================================================================
' COMPONENT TYPE GUESS
' ================================================================

Function GuessComponentType( _
    partNumber As String, _
    description As String, _
    occurrenceName As String) As String


    Dim text As String = _
        (partNumber & " " & _
         description & " " & _
         occurrenceName).ToLowerInvariant()


    If Regex.IsMatch(text, "\bflange\b") Then

        Return "FLANGE"

    ElseIf Regex.IsMatch(text, "\breducer\b") Then

        Return "REDUCER"

    ElseIf Regex.IsMatch(text, "\b(elbow|bend)\b") Then

        Return "ELBOW"

    ElseIf Regex.IsMatch(text, "\btee\b") Then

        Return "TEE"

    ElseIf Regex.IsMatch(text, "\bvalve\b") Then

        Return "VALVE"

    ElseIf Regex.IsMatch(text, "\b(pipe|tube)\b") Then

        Return "PIPE"

    ElseIf Regex.IsMatch( _
        text, _
        "\b(socket|coupling|union)\b") Then

        Return "COUPLING_SOCKET"

    End If


    Return "OTHER"

End Function



' ================================================================
' GET IPROPERTY
' ================================================================

Function GetIProperty( _
    doc As Document, _
    propertySetName As String, _
    propertyName As String) As String


    Try

        Return _
            doc.PropertySets _
               .Item(propertySetName) _
               .Item(propertyName) _
               .Value _
               .ToString() _
               .Trim()

    Catch

        Return ""

    End Try

End Function



' ================================================================
' CSV STRING
' ================================================================

Function Csv(value As String) As String


    If value Is Nothing Then
        value = ""
    End If


    value = value.Replace("""", """""")


    Return """" & value & """"

End Function



' ================================================================
' NUMBER
' ================================================================

Function Num(value As Double) As String


    Return _
        value.ToString( _
            "0.###", _
            CultureInfo.InvariantCulture)

End Function



' ================================================================
' XML SAFE TEXT
' ================================================================

Function XmlText(value As String) As String


    If value Is Nothing Then
        Return ""
    End If


    Return _
        value.Replace("&", "&amp;") _
             .Replace("<", "&lt;") _
             .Replace(">", "&gt;") _
             .Replace("""", "&quot;")

End Function



' ================================================================
' SAFE FILE NAME
' ================================================================

Function SafeFileName(value As String) As String


    For Each invalidChar As Char In _
        System.IO.Path.GetInvalidFileNameChars()


        value = _
            value.Replace( _
                invalidChar, _
                "_"c)

    Next


    Return value

End Function



' ================================================================
' DATA CLASSES
' ================================================================

Class NodeRecord

    Public OccurrenceName As String = ""

    Public PartNumber As String = ""

    Public Description As String = ""

    Public ComponentType As String = "OTHER"

    Public Code As String = ""


    Public X As Double

    Public Y As Double

    Public Z As Double


    Public Ports As New List(Of PortRecord)

    Public Neighbours As New List(Of NodeRecord)

End Class



Class PortRecord

    Public Owner As NodeRecord

    Public FaceIndex As Integer


    Public X As Double

    Public Y As Double

    Public Z As Double


    Public NX As Double

    Public NY As Double

    Public NZ As Double


    Public Radius As Double


    Public Used As Boolean = False

End Class



Class EdgeRecord

    Public A As NodeRecord

    Public B As NodeRecord


    Public ConnectionType As String = ""


    Public ConnectionDistance As Double

End Class



Class SvgPoint

    Public X As Double

    Public Y As Double


    Public Sub New( _
        xValue As Double, _
        yValue As Double)


        X = xValue

        Y = yValue

    End Sub

End Class